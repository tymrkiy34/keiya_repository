# .env にコピーして編集（.env はGitに含まれません）
PORT=3000
# 通知メール・LINEに載せるアプリのURL（任意）
APP_URL=http://192.168.0.10:3000

# --- LINE（LINE公式アカウントの Messaging API）---
# LINE Developers でチャネルアクセストークン（長期）を発行
LINE_CHANNEL_TOKEN=
# 送信先のグループID/ユーザーID。空欄なら友だち全員に配信
LINE_TO=

# --- メール（SMTP）---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls（587）/ ssl（465）/ none（25）
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=スマイル歯科 <clinic@example.com>

# 前日リマインダー（明日の予定を通知する時刻・時）と時差
REMINDER_HOUR=17
TZ_OFFSET_HOURS=9
# 在庫が発注点を下回った時の通知（0で無効）
INVENTORY_NOTIFY=1

# HTTPS で公開する場合は 1（Cookieに Secure を付与）
COOKIE_SECURE=0
